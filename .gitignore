# .NET build output
bin/
obj/
*.user
*.suo
.vs/

# SQLite databases (runtime data)
*.db
*.db-shm
*.db-wal

# Data Protection key ring (secret key material — never commit)
keys/

# Deployment secrets (pepper, operator token) — never commit
.env
.env.*
deploy/.env*
*.secret
# ...but the template carries no secrets and must be committed.
!deploy/.env.example

# Test / coverage
[Tt]est[Rr]esults/
*.coverage
coverage/

# macOS finder metadata
.DS_Store
