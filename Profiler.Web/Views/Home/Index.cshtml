@{
    ViewBag.Title = "Home";
}

<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">🔐 Find Your People<br><span class="gradient-text">Without Sharing Your Data</span></h1>
        <p class="hero-subtitle">Connect your favourite platforms. We compute a privacy-preserving fingerprint. Get matched with like-minded people — no raw data ever stored.</p>
        <div class="hero-cta">
            <a href="/account/register" class="btn btn-primary">Get Started Free</a>
            <a href="/account/login" class="btn btn-secondary">Sign In</a>
        </div>
    </div>
</section>

<section class="how-it-works">
    <div class="container">
        <h2 class="section-title">How It Works</h2>
        <div class="steps-grid">
            <div class="step-card">
                <div class="step-icon">🔌</div>
                <h3>1. Connect</h3>
                <p>Link your GitHub, Goodreads, Netflix, and other accounts to let us discover your interests.</p>
            </div>
            <div class="step-card">
                <div class="step-icon">🔒</div>
                <h3>2. Fingerprint</h3>
                <p>We compute a MinHash fingerprint — a compact privacy-preserving representation. Raw features are discarded.</p>
            </div>
            <div class="step-card">
                <div class="step-icon">🤝</div>
                <h3>3. Match</h3>
                <p>Your fingerprint is compared with others using Jaccard similarity to surface the best matches.</p>
            </div>
        </div>
    </div>
</section>

<section class="sources-section">
    <div class="container">
        <h2 class="section-title">Supported Sources</h2>
        <div class="sources-grid">
            <div class="source-card github-card">
                <div class="source-icon">🐙</div>
                <h3>GitHub</h3>
                <p>Languages, topics, starred repos</p>
            </div>
            <div class="source-card goodreads-card">
                <div class="source-icon">📚</div>
                <h3>Goodreads</h3>
                <p>Reading history, genres, ratings</p>
            </div>
            <div class="source-card netflix-card">
                <div class="source-icon">🎬</div>
                <h3>Netflix</h3>
                <p>Watch history, genres</p>
            </div>
            <div class="source-card google-card">
                <div class="source-icon">🔍</div>
                <h3>Google</h3>
                <p>Interests, locale, organisations</p>
            </div>
            <div class="source-card facebook-card">
                <div class="source-icon">👍</div>
                <h3>Facebook</h3>
                <p>Likes, interests, education</p>
            </div>
            <div class="source-card pinterest-card">
                <div class="source-icon">📌</div>
                <h3>Pinterest</h3>
                <p>Boards, followed boards, topics</p>
            </div>
        </div>
        <div class="coming-soon-note">
            <p>💡 <strong>Additional sources coming soon:</strong> Spotify, Twitter/X, LinkedIn, Reddit, Last.fm, Steam</p>
        </div>
    </div>
</section>
