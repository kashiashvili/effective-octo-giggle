@inject Profiler.Web.Security.FeatureFlags Flags
@{
    ViewBag.Title = "Home";
}

<section class="hero">
    <div class="container">
        <h1>🔐 Find Your People<br><span>Without Sharing Your Data</span></h1>
        <p>Pick your interests from a list, or connect a platform you already use. We turn them into a privacy-preserving fingerprint and keep nothing else. Then meet like-minded people — no raw data ever stored.</p>
        <div class="hero-btns">
            <a href="/account/register" class="btn btn-primary">Get Started Free</a>
            <a href="/account/login" class="btn btn-light">Sign In</a>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <h2 class="section-title">How It <span>Works</span></h2>
        <div class="step-cards">
            <div class="step-card">
                <div class="step-icon">✏️</div>
                <h3>1. Describe or connect</h3>
                <p>Pick what you're into from a list — no accounts needed — or connect a source you already have: a GitHub username, a Goodreads, Netflix or YouTube export, an RSS feed. Then, if you like, two minutes on what matters to you.</p>
            </div>
            <div class="step-card">
                <div class="step-icon">🔒</div>
                <h3>2. Fingerprint</h3>
                <p>We compute a MinHash fingerprint — a compact privacy-preserving representation. Raw features are discarded.</p>
            </div>
            <div class="step-card">
                <div class="step-icon">🤝</div>
                <h3>3. Match</h3>
                <p>Your fingerprint is compared with others using Jaccard similarity to surface the best matches@(Flags.CirclesEnabled ? " — and anyone from a circle you share is marked, so your own group finds each other first" : "").</p>
            </div>
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <h2 class="section-title">Your Privacy, <span>Your Control</span></h2>
        <div class="step-cards">
            <div class="step-card">
                <div class="step-icon indigo">🛡️</div>
                <h3>Raw data never stored</h3>
                <p>Your interests are turned into an anonymous MinHash fingerprint and then discarded. There's nothing to leak.</p>
            </div>
            <div class="step-card">
                <div class="step-icon green">🗂️</div>
                <h3>See exactly what we keep</h3>
                <p>A transparency page shows everything stored about you — and lets you download it as JSON any time.</p>
            </div>
            <div class="step-card">
                <div class="step-icon amber">🙈</div>
                <h3>Hide when you want</h3>
                <p>Go undiscoverable in one tap, or hide a specific person so neither of you appears to the other.</p>
            </div>
        </div>
        <p class="text-center text-muted mt-4">And you can delete your account — and all of your data — in one click, any time.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <h2 class="section-title">Sources you <span>can</span> connect</h2>
        <p class="text-center text-muted mb-4">
            You never need one — describing your interests builds the same fingerprint. A source just makes it sharper.
            <strong>No account or token needed:</strong> GitHub (username), Goodreads, Netflix and YouTube (your own export), RSS feeds.
        </p>
        <div class="sources-grid">
            <div class="source-card github-card">
                <div class="source-icon">🐙</div>
                <h3>GitHub</h3>
                <p>Languages, topics, starred repos</p>
            </div>
            <div class="source-card goodreads-card">
                <div class="source-icon">📚</div>
                <h3>Goodreads</h3>
                <p>Reading history, genres, ratings</p>
            </div>
            <div class="source-card netflix-card">
                <div class="source-icon">🎬</div>
                <h3>Netflix</h3>
                <p>Watch history, genres</p>
            </div>
            <div class="source-card rss-card">
                <div class="source-icon">📰</div>
                <h3>RSS / Blogs</h3>
                <p>Topics from subscribed feeds</p>
            </div>
            <div class="source-card youtube-card">
                <div class="source-icon">📺</div>
                <h3>YouTube</h3>
                <p>Subscribed channels &amp; liked video tags</p>
            </div>
        </div>
        <details class="sources-more mt-4">
            <summary>The other sources — each takes an API token you create yourself</summary>
            <p class="text-muted mt-2 mb-3">Skip these unless you already have a token — the interests list and the sources above need nothing.</p>
            <div class="sources-grid">
            <div class="source-card google-card">
                <div class="source-icon">🔍</div>
                <h3>Google</h3>
                <p>Interests, locale, organisations</p>
            </div>
            <div class="source-card facebook-card">
                <div class="source-icon">👍</div>
                <h3>Facebook</h3>
                <p>Likes, interests, education</p>
            </div>
            <div class="source-card pinterest-card">
                <div class="source-icon">📌</div>
                <h3>Pinterest</h3>
                <p>Boards, followed boards, topics</p>
            </div>
            <div class="source-card spotify-card">
                <div class="source-icon">🎵</div>
                <h3>Spotify</h3>
                <p>Top artists, genres, playlists</p>
            </div>
            <div class="source-card twitter-card">
                <div class="source-icon">🐦</div>
                <h3>Twitter / X</h3>
                <p>Liked tweet topics &amp; hashtags</p>
            </div>
            <div class="source-card linkedin-card">
                <div class="source-icon">💼</div>
                <h3>LinkedIn</h3>
                <p>Skills, job titles, industries</p>
            </div>
            <div class="source-card reddit-card">
                <div class="source-icon">🤖</div>
                <h3>Reddit</h3>
                <p>Subscribed subreddits</p>
            </div>
            <div class="source-card lastfm-card">
                <div class="source-icon">🎸</div>
                <h3>Last.fm</h3>
                <p>Top artists, tags, scrobbles</p>
            </div>
            <div class="source-card steam-card">
                <div class="source-icon">🎮</div>
                <h3>Steam</h3>
                <p>Owned games &amp; playtime profile</p>
            </div>
            <div class="source-card tiktok-card">
                <div class="source-icon">🎬</div>
                <h3>TikTok</h3>
                <p>Hashtags &amp; followed creators</p>
            </div>
            <div class="source-card instagram-card">
                <div class="source-icon">📸</div>
                <h3>Instagram</h3>
                <p>Media types &amp; post hashtags</p>
            </div>
            <div class="source-card twitch-card">
                <div class="source-icon">🎮</div>
                <h3>Twitch</h3>
                <p>Followed channels &amp; game categories</p>
            </div>
            <div class="source-card soundcloud-card">
                <div class="source-icon">🎵</div>
                <h3>SoundCloud</h3>
                <p>Liked tracks &amp; genres</p>
            </div>
            </div>
        </details>
    </div>
</section>
