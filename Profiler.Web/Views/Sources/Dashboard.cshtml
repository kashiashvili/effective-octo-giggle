@{
    ViewBag.Title = "Dashboard";
    bool hasFingerprint = ViewBag.HasFingerprint ?? false;
    var sources = ViewBag.Sources as List<string> ?? new List<string>();
    var username = Context.Session.GetString("Username") ?? "";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>👋 Welcome back, <span class="gradient-text">@username</span></h1>
        <p class="dashboard-subtitle">Your privacy-preserving social profile</p>
    </div>

    <div class="status-grid">
        <div class="status-card @(hasFingerprint ? "status-active" : "status-inactive")">
            <div class="status-icon">@(hasFingerprint ? "✅" : "⏳")</div>
            <h3>Fingerprint</h3>
            <p>@(hasFingerprint ? "Generated" : "Not yet generated")</p>
        </div>
        <div class="status-card @(sources.Count > 0 ? "status-active" : "status-inactive")">
            <div class="status-icon">@(sources.Count > 0 ? "🔌" : "❌")</div>
            <h3>Sources Connected</h3>
            <p>@(sources.Count > 0 ? string.Join(", ", sources) : "None yet")</p>
        </div>
    </div>

    <div class="dashboard-actions">
        <a href="/sources/connect" class="btn btn-primary">@(hasFingerprint ? "Update Sources" : "Connect Sources")</a>
        @if (hasFingerprint)
        {
            <a href="/matches" class="btn btn-secondary">View Matches</a>
        }
    </div>
</div>
