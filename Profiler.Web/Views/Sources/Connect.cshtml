@model Profiler.Web.ViewModels.ConnectSourcesViewModel
@{
    ViewBag.Title = "Connect Sources";
}

<div class="page-wrap">
  <div class="container">
    <div class="connect-header">
        <h1>🔌 Connect Your Sources</h1>
        <p>Link your accounts to generate your privacy-preserving fingerprint. Raw data is never stored.</p>
        @{
            var connected = ViewBag.ConnectedSources as List<string> ?? new List<string>();
        }
        @if (connected.Any())
        {
            <p class="mt-2">
                <span class="text-muted">Already connected (submitting one again refreshes just that source):</span>
                @foreach (var s in connected)
                {
                    <span class="source-badge">@s</span>
                }
            </p>
        }
    </div>

    <form asp-action="Connect" asp-controller="Sources" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        @if (!connected.Any())
        {
            <div class="alert alert-info start-here">
                <span class="alert-icon">👉</span>
                <span>
                    <strong>New here?</strong> The quickest sources need no tokens — just enter a
                    <strong>GitHub username</strong>, paste some <strong>RSS feed URLs</strong>, or upload a
                    <strong>Goodreads, Netflix or YouTube (Takeout) export</strong>. Connect one now; you can always add more later.
                    The remaining cards accept OAuth tokens if you already have them.
                </span>
            </div>
        }

        <div class="alert alert-info start-here">
            <span class="alert-icon">✏️</span>
            <span>
                <strong>No account to connect at all?</strong> You don't need one.
                <a href="/sources/interests">Describe your interests</a> from a list — we build the same
                anonymous fingerprint and keep nothing about what you picked.
            </span>
        </div>

        <h2 class="source-group-title">No account needed</h2>
        <p class="source-group-hint">Fastest way to start — just a username, a file, or a feed URL.</p>

        <div class="sources-form-grid">
            <!-- GitHub -->
            <div class="source-form-card github-card">
                <div class="source-form-header">
                    <span class="source-icon">🐙</span>
                    <h3>GitHub</h3>
                </div>
                <div class="form-group">
                    <label>GitHub Username</label>
                    <input asp-for="GitHubUser" class="form-control" placeholder="e.g. octocat" />
                </div>
                <div class="form-group">
                    <label>Personal Access Token (optional)</label>
                    <input asp-for="GitHubToken" class="form-control" placeholder="ghp_..." type="password" />
                    <small>Increases rate limits. Read-only scopes sufficient.</small>
                </div>
            </div>

            <!-- Goodreads -->
            <div class="source-form-card goodreads-card">
                <div class="source-form-header">
                    <span class="source-icon">📚</span>
                    <h3>Goodreads</h3>
                </div>
                <div class="form-group">
                    <label>Export CSV</label>
                    <input asp-for="GoodreadsCsv" type="file" class="form-control" accept=".csv" />
                    <small>Export from Goodreads → My Books → Import/Export</small>
                </div>
            </div>

            <!-- Netflix -->
            <div class="source-form-card netflix-card">
                <div class="source-form-header">
                    <span class="source-icon">🎬</span>
                    <h3>Netflix</h3>
                </div>
                <div class="form-group">
                    <label>Viewing History CSV</label>
                    <input asp-for="NetflixCsv" type="file" class="form-control" accept=".csv" />
                    <small>From Netflix → Account → Viewing Activity → Download</small>
                </div>
            </div>

            <!-- YouTube (Google Takeout export, no token) -->
            <div class="source-form-card youtube-card">
                <div class="source-form-header">
                    <span class="source-icon">📺</span>
                    <h3>YouTube</h3>
                </div>
                <div class="form-group">
                    <label>Subscriptions CSV (Google Takeout)</label>
                    <input asp-for="YouTubeSubscriptionsCsv" type="file" class="form-control" accept=".csv" />
                    <small>takeout.google.com → deselect all → YouTube and YouTube Music → limit to <em>subscriptions</em> → export. The file is <code>subscriptions.csv</code>. No token needed; matches people who connected YouTube either way.</small>
                </div>
            </div>

            <!-- RSS/Blogs -->
            <div class="source-form-card rss-card">
                <div class="source-form-header">
                    <span class="source-icon">📰</span>
                    <h3>RSS / Blogs</h3>
                </div>
                <div class="form-group">
                    <label>Feed URLs</label>
                    <textarea asp-for="RssFeedUrls" class="form-control" rows="4" placeholder="https://example.com/feed&#10;https://blog.example.org/rss"></textarea>
                    <small>Enter one URL per line (up to 10 feeds). No account needed.</small>
                </div>
            </div>
        </div>

        <h2 class="source-group-title">Needs a token or API key</h2>
        <p class="source-group-hint">
            These need an OAuth access token or API key from the provider. Skip them unless you already have one.
        </p>

        <div class="sources-form-grid">
            <!-- Google -->
            <div class="source-form-card google-card">
                <div class="source-form-header">
                    <span class="source-icon">🔍</span>
                    <h3>Google</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="GoogleToken" class="form-control" placeholder="ya29...." type="password" />
                    <small>Requires People API scope</small>
                </div>
            </div>

            <!-- Facebook -->
            <div class="source-form-card facebook-card">
                <div class="source-form-header">
                    <span class="source-icon">👍</span>
                    <h3>Facebook</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="FacebookToken" class="form-control" placeholder="EAA..." type="password" />
                    <small>Requires user_likes, user_interests permissions</small>
                </div>
            </div>

            <!-- Pinterest -->
            <div class="source-form-card pinterest-card">
                <div class="source-form-header">
                    <span class="source-icon">📌</span>
                    <h3>Pinterest</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="PinterestToken" class="form-control" placeholder="pina_..." type="password" />
                    <small>Requires boards:read permission</small>
                </div>
            </div>

            <!-- Spotify -->
            <div class="source-form-card spotify-card">
                <div class="source-form-header">
                    <span class="source-icon">🎵</span>
                    <h3>Spotify</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="SpotifyToken" class="form-control" placeholder="BQA..." type="password" />
                    <small>Requires user-top-read, playlist-read-private scopes</small>
                </div>
            </div>

            <!-- Twitter/X -->
            <div class="source-form-card twitter-card">
                <div class="source-form-header">
                    <span class="source-icon">🐦</span>
                    <h3>Twitter / X</h3>
                </div>
                <div class="form-group">
                    <label>Bearer Token</label>
                    <input asp-for="TwitterToken" class="form-control" placeholder="AAAA..." type="password" />
                    <small>Twitter API v2 user Bearer token</small>
                </div>
            </div>

            <!-- LinkedIn -->
            <div class="source-form-card linkedin-card">
                <div class="source-form-header">
                    <span class="source-icon">💼</span>
                    <h3>LinkedIn</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="LinkedInToken" class="form-control" placeholder="AQV..." type="password" />
                    <small>Requires r_liteprofile, r_emailaddress permissions</small>
                </div>
            </div>

            <!-- Reddit -->
            <div class="source-form-card reddit-card">
                <div class="source-form-header">
                    <span class="source-icon">🤖</span>
                    <h3>Reddit</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="RedditToken" class="form-control" placeholder="eyJ..." type="password" />
                    <small>Reddit OAuth Bearer token with mysubreddits scope</small>
                </div>
            </div>

            <!-- Last.fm -->
            <div class="source-form-card lastfm-card">
                <div class="source-form-header">
                    <span class="source-icon">🎸</span>
                    <h3>Last.fm</h3>
                </div>
                <div class="form-group">
                    <label>API Key</label>
                    <input asp-for="LastFmApiKey" class="form-control" placeholder="Last.fm API key" type="password" />
                </div>
                <div class="form-group">
                    <label>Username</label>
                    <input asp-for="LastFmUsername" class="form-control" placeholder="your_lastfm_username" />
                    <small>Get API key at last.fm/api/account/create</small>
                </div>
            </div>

            <!-- Steam -->
            <div class="source-form-card steam-card">
                <div class="source-form-header">
                    <span class="source-icon">🎮</span>
                    <h3>Steam</h3>
                </div>
                <div class="form-group">
                    <label>API Key</label>
                    <input asp-for="SteamApiKey" class="form-control" placeholder="Steam Web API key" type="password" />
                </div>
                <div class="form-group">
                    <label>Steam ID</label>
                    <input asp-for="SteamId" class="form-control" placeholder="76561198..." />
                    <small>Get API key at steamcommunity.com/dev/apikey</small>
                </div>
            </div>

            <!-- TikTok -->
            <div class="source-form-card tiktok-card">
                <div class="source-form-header">
                    <span class="source-icon">🎬</span>
                    <h3>TikTok</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="TikTokToken" class="form-control" placeholder="act.xxx..." type="password" />
                    <small>TikTok Display API v2 — requires user.info.basic, video.list scopes</small>
                </div>
            </div>

            <!-- Instagram -->
            <div class="source-form-card instagram-card">
                <div class="source-form-header">
                    <span class="source-icon">📸</span>
                    <h3>Instagram</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="InstagramToken" class="form-control" placeholder="IGQV..." type="password" />
                    <small>Instagram Basic Display API — requires user_media scope</small>
                </div>
            </div>

            <!-- Twitch -->
            <div class="source-form-card twitch-card">
                <div class="source-form-header">
                    <span class="source-icon">🎮</span>
                    <h3>Twitch</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="TwitchToken" class="form-control" placeholder="oauth:..." type="password" />
                    <small>Requires follows:read scope</small>
                </div>
                <div class="form-group">
                    <label>Client ID</label>
                    <input asp-for="TwitchClientId" class="form-control" placeholder="Your Twitch app Client ID" />
                    <small>From dev.twitch.tv — required alongside the access token</small>
                </div>
            </div>

            <!-- SoundCloud -->
            <div class="source-form-card soundcloud-card">
                <div class="source-form-header">
                    <span class="source-icon">🎵</span>
                    <h3>SoundCloud</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="SoundCloudToken" class="form-control" placeholder="2-xxx..." type="password" />
                    <small>SoundCloud API — get from soundcloud.com/you/apps</small>
                </div>
            </div>

            <!-- YouTube -->
            <div class="source-form-card youtube-card">
                <div class="source-form-header">
                    <span class="source-icon">📺</span>
                    <h3>YouTube</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="YouTubeToken" class="form-control" placeholder="ya29..." type="password" />
                    <small>Google OAuth — requires youtube.readonly scope. Or upload your Takeout subscriptions export in the "No account needed" section — no token required.</small>
                </div>
            </div>
        </div>

        <div class="form-submit">
            <button type="submit" class="btn btn-primary btn-lg">Generate My Fingerprint 🔒</button>
        </div>
    </form>
  </div>
</div>
