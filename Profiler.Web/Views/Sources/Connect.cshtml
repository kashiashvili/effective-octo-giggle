@model Profiler.Web.ViewModels.ConnectSourcesViewModel
@{
    ViewBag.Title = "Connect Sources";
}

<div class="connect-container">
    <div class="connect-header">
        <h1>🔌 Connect Your Sources</h1>
        <p>Link your accounts to generate your privacy-preserving fingerprint. Raw data is never stored.</p>
    </div>

    <form asp-action="Connect" asp-controller="Sources" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

        <div class="sources-form-grid">
            <!-- GitHub -->
            <div class="source-form-card github-card">
                <div class="source-form-header">
                    <span class="source-icon">🐙</span>
                    <h3>GitHub</h3>
                </div>
                <div class="form-group">
                    <label>GitHub Username</label>
                    <input asp-for="GitHubUser" class="form-control" placeholder="e.g. octocat" />
                </div>
                <div class="form-group">
                    <label>Personal Access Token (optional)</label>
                    <input asp-for="GitHubToken" class="form-control" placeholder="ghp_..." type="password" />
                    <small>Increases rate limits. Read-only scopes sufficient.</small>
                </div>
            </div>

            <!-- Goodreads -->
            <div class="source-form-card goodreads-card">
                <div class="source-form-header">
                    <span class="source-icon">📚</span>
                    <h3>Goodreads</h3>
                </div>
                <div class="form-group">
                    <label>Export CSV</label>
                    <input asp-for="GoodreadsCsv" type="file" class="form-control" accept=".csv" />
                    <small>Export from Goodreads → My Books → Import/Export</small>
                </div>
            </div>

            <!-- Netflix -->
            <div class="source-form-card netflix-card">
                <div class="source-form-header">
                    <span class="source-icon">🎬</span>
                    <h3>Netflix</h3>
                </div>
                <div class="form-group">
                    <label>Viewing History CSV</label>
                    <input asp-for="NetflixCsv" type="file" class="form-control" accept=".csv" />
                    <small>From Netflix → Account → Viewing Activity → Download</small>
                </div>
            </div>

            <!-- Google -->
            <div class="source-form-card google-card">
                <div class="source-form-header">
                    <span class="source-icon">🔍</span>
                    <h3>Google</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="GoogleToken" class="form-control" placeholder="ya29...." type="password" />
                    <small>Requires People API scope</small>
                </div>
            </div>

            <!-- Facebook -->
            <div class="source-form-card facebook-card">
                <div class="source-form-header">
                    <span class="source-icon">👍</span>
                    <h3>Facebook</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="FacebookToken" class="form-control" placeholder="EAA..." type="password" />
                    <small>Requires user_likes, user_interests permissions</small>
                </div>
            </div>

            <!-- Pinterest -->
            <div class="source-form-card pinterest-card">
                <div class="source-form-header">
                    <span class="source-icon">📌</span>
                    <h3>Pinterest</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="PinterestToken" class="form-control" placeholder="pina_..." type="password" />
                    <small>Requires boards:read permission</small>
                </div>
            </div>
        </div>

        <div class="coming-soon-section">
            <h3>💡 More sources coming soon</h3>
            <ul class="coming-soon-list">
                <li>🎵 <strong>Spotify</strong> — listening history &amp; genres</li>
                <li>🐦 <strong>Twitter/X</strong> — liked tweets topics</li>
                <li>💼 <strong>LinkedIn</strong> — skills, job titles</li>
                <li>🤖 <strong>Reddit</strong> — subscribed subreddits</li>
                <li>🎸 <strong>Last.fm</strong> — artist &amp; genre scrobbles</li>
                <li>🎮 <strong>Steam</strong> — game genres &amp; tags</li>
            </ul>
        </div>

        <div class="form-submit">
            <button type="submit" class="btn btn-primary btn-large">Generate My Fingerprint 🔒</button>
        </div>
    </form>
</div>
