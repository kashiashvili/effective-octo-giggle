@model Profiler.Web.ViewModels.ConnectSourcesViewModel
@{
    ViewBag.Title = "Connect Sources";
}

<div class="connect-container">
    <div class="connect-header">
        <h1>🔌 Connect Your Sources</h1>
        <p>Link your accounts to generate your privacy-preserving fingerprint. Raw data is never stored.</p>
    </div>

    <form asp-action="Connect" asp-controller="Sources" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

        <div class="sources-form-grid">
            <!-- GitHub -->
            <div class="source-form-card github-card">
                <div class="source-form-header">
                    <span class="source-icon">🐙</span>
                    <h3>GitHub</h3>
                </div>
                <div class="form-group">
                    <label>GitHub Username</label>
                    <input asp-for="GitHubUser" class="form-control" placeholder="e.g. octocat" />
                </div>
                <div class="form-group">
                    <label>Personal Access Token (optional)</label>
                    <input asp-for="GitHubToken" class="form-control" placeholder="ghp_..." type="password" />
                    <small>Increases rate limits. Read-only scopes sufficient.</small>
                </div>
            </div>

            <!-- Goodreads -->
            <div class="source-form-card goodreads-card">
                <div class="source-form-header">
                    <span class="source-icon">📚</span>
                    <h3>Goodreads</h3>
                </div>
                <div class="form-group">
                    <label>Export CSV</label>
                    <input asp-for="GoodreadsCsv" type="file" class="form-control" accept=".csv" />
                    <small>Export from Goodreads → My Books → Import/Export</small>
                </div>
            </div>

            <!-- Netflix -->
            <div class="source-form-card netflix-card">
                <div class="source-form-header">
                    <span class="source-icon">🎬</span>
                    <h3>Netflix</h3>
                </div>
                <div class="form-group">
                    <label>Viewing History CSV</label>
                    <input asp-for="NetflixCsv" type="file" class="form-control" accept=".csv" />
                    <small>From Netflix → Account → Viewing Activity → Download</small>
                </div>
            </div>

            <!-- Google -->
            <div class="source-form-card google-card">
                <div class="source-form-header">
                    <span class="source-icon">🔍</span>
                    <h3>Google</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="GoogleToken" class="form-control" placeholder="ya29...." type="password" />
                    <small>Requires People API scope</small>
                </div>
            </div>

            <!-- Facebook -->
            <div class="source-form-card facebook-card">
                <div class="source-form-header">
                    <span class="source-icon">👍</span>
                    <h3>Facebook</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="FacebookToken" class="form-control" placeholder="EAA..." type="password" />
                    <small>Requires user_likes, user_interests permissions</small>
                </div>
            </div>

            <!-- Pinterest -->
            <div class="source-form-card pinterest-card">
                <div class="source-form-header">
                    <span class="source-icon">📌</span>
                    <h3>Pinterest</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="PinterestToken" class="form-control" placeholder="pina_..." type="password" />
                    <small>Requires boards:read permission</small>
                </div>
            </div>

            <!-- Spotify -->
            <div class="source-form-card spotify-card">
                <div class="source-form-header">
                    <span class="source-icon">🎵</span>
                    <h3>Spotify</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="SpotifyToken" class="form-control" placeholder="BQA..." type="password" />
                    <small>Requires user-top-read, playlist-read-private scopes</small>
                </div>
            </div>

            <!-- Twitter/X -->
            <div class="source-form-card twitter-card">
                <div class="source-form-header">
                    <span class="source-icon">🐦</span>
                    <h3>Twitter / X</h3>
                </div>
                <div class="form-group">
                    <label>Bearer Token</label>
                    <input asp-for="TwitterToken" class="form-control" placeholder="AAAA..." type="password" />
                    <small>Twitter API v2 user Bearer token</small>
                </div>
            </div>

            <!-- LinkedIn -->
            <div class="source-form-card linkedin-card">
                <div class="source-form-header">
                    <span class="source-icon">💼</span>
                    <h3>LinkedIn</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="LinkedInToken" class="form-control" placeholder="AQV..." type="password" />
                    <small>Requires r_liteprofile, r_emailaddress permissions</small>
                </div>
            </div>

            <!-- Reddit -->
            <div class="source-form-card reddit-card">
                <div class="source-form-header">
                    <span class="source-icon">🤖</span>
                    <h3>Reddit</h3>
                </div>
                <div class="form-group">
                    <label>OAuth Access Token</label>
                    <input asp-for="RedditToken" class="form-control" placeholder="eyJ..." type="password" />
                    <small>Reddit OAuth Bearer token with mysubreddits scope</small>
                </div>
            </div>

            <!-- Last.fm -->
            <div class="source-form-card lastfm-card">
                <div class="source-form-header">
                    <span class="source-icon">🎸</span>
                    <h3>Last.fm</h3>
                </div>
                <div class="form-group">
                    <label>API Key</label>
                    <input asp-for="LastFmApiKey" class="form-control" placeholder="Last.fm API key" type="password" />
                </div>
                <div class="form-group">
                    <label>Username</label>
                    <input asp-for="LastFmUsername" class="form-control" placeholder="your_lastfm_username" />
                    <small>Get API key at last.fm/api/account/create</small>
                </div>
            </div>

            <!-- Steam -->
            <div class="source-form-card steam-card">
                <div class="source-form-header">
                    <span class="source-icon">🎮</span>
                    <h3>Steam</h3>
                </div>
                <div class="form-group">
                    <label>API Key</label>
                    <input asp-for="SteamApiKey" class="form-control" placeholder="Steam Web API key" type="password" />
                </div>
                <div class="form-group">
                    <label>Steam ID</label>
                    <input asp-for="SteamId" class="form-control" placeholder="76561198..." />
                    <small>Get API key at steamcommunity.com/dev/apikey</small>
                </div>
            </div>
        </div>

        <div class="coming-soon-section">
            <h3>💡 More sources to come</h3>
            <ul class="coming-soon-list">
                <li>🎬 <strong>TikTok</strong> — followed creators &amp; hashtags</li>
                <li>📸 <strong>Instagram</strong> — followed hashtags &amp; interests</li>
                <li>🎮 <strong>Twitch</strong> — followed streamers &amp; game categories</li>
                <li>📰 <strong>RSS/Blogs</strong> — topics from subscribed feeds</li>
                <li>🎵 <strong>SoundCloud</strong> — liked tracks &amp; genres</li>
                <li>📺 <strong>YouTube</strong> — subscribed channel topics</li>
            </ul>
        </div>

        <div class="form-submit">
            <button type="submit" class="btn btn-primary btn-large">Generate My Fingerprint 🔒</button>
        </div>
    </form>
</div>
