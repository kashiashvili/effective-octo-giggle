<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewBag.Title ?? "Profiler") – Privacy-First Social Matching</title>
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>
    <a href="#main" class="skip-link">Skip to content</a>
    <nav class="navbar">
        <div class="container">
            <a href="/" class="navbar-brand"><span class="brand-dot"></span>🔐 Profiler</a>
            <button type="button" class="navbar-toggler" aria-label="Toggle navigation" aria-expanded="false"
                    onclick="var open=this.getAttribute('aria-expanded')==='true';this.setAttribute('aria-expanded',String(!open));document.querySelector('.navbar-collapse').classList.toggle('open')">☰</button>
            <div class="navbar-collapse">
                <ul class="navbar-nav">
                    <li><a href="/" class="nav-link">Home</a></li>
                    @{
                        var username = User.Identity?.IsAuthenticated == true ? User.Identity!.Name : null;
                    }
                    @if (username != null)
                    {
                        <li><a href="/sources/dashboard" class="nav-link">Dashboard</a></li>
                        <li><a href="/sources/connect" class="nav-link">Connect</a></li>
                        <li><a href="/matches" class="nav-link">Matches</a></li>
                        <li><span class="navbar-username">👤 @username</span></li>
                        <li>
                            <form asp-action="Logout" asp-controller="Account" method="post" style="display:inline">
                                <button type="submit" class="nav-link" data-no-busy style="background:none;border:none;cursor:pointer">Sign out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li><a href="/account/login" class="nav-link">Login</a></li>
                        <li><a href="/account/register" class="btn btn-light btn-sm">Register</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main id="main">
        @if (TempData["Success"] != null || TempData["Error"] != null)
        {
            <div class="container flash-area">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success" role="status"><i class="alert-icon">✅</i> @TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-warning" role="alert"><i class="alert-icon">⚠️</i> @TempData["Error"]</div>
                }
            </div>
        }
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <p>🔐 Profiler — Privacy-preserving social matching. Your raw data is never stored. <a href="/home/privacy">How we protect your data</a></p>
            @{
                // Stamped into the image by CI. Shown so anyone can tell which commit is actually
                // running without shell access — the quickest way to confirm a deploy landed. Hidden
                // for local/hand-built images, which carry the "dev" placeholder.
                var buildSha = Context.RequestServices
                    .GetService<IConfiguration>()?["Build:Sha"];
            }
            @if (!string.IsNullOrWhiteSpace(buildSha) && buildSha != "dev")
            {
                <p class="build-stamp">build @(buildSha.Length > 7 ? buildSha[..7] : buildSha)</p>
            }
        </div>
    </footer>
    <script src="~/js/site.js" defer></script>
</body>
</html>
