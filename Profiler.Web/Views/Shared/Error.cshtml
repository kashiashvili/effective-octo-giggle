@model ErrorViewModel
@{
    ViewBag.Title = "Error";
}

<div class="page-wrap">
    <div class="container">
        <div class="empty-state">
            <div class="empty-icon">😵</div>
            <h4>Something went wrong</h4>
            <p>An unexpected error occurred while processing your request. Please try again.</p>
            @if (Model.ShowRequestId)
            {
                <p class="text-muted mt-2"><small>Request ID: <code>@Model.RequestId</code></small></p>
            }
            <p class="mt-4"><a href="/" class="btn btn-primary">Back to Home</a></p>
        </div>
    </div>
</div>
