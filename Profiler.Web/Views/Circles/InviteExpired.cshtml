@{
    ViewBag.Title = "Invite link expired";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>⏳ This invite link has expired</h1>
        <p class="text-center text-muted mb-4">
            Invite links work for @Profiler.Web.Security.CircleInvites.Lifetime.TotalDays days. Ask anyone in the circle for a fresh one — their dashboard always shows a current link.
        </p>
        <a href="/" class="btn btn-primary btn-block">Back to home</a>
    </div>
</div>
