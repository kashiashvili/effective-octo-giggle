@model List<Profiler.Web.ViewModels.MatchViewModel>
@{
    ViewBag.Title = "Your Matches";
    bool noFingerprint = ViewBag.NoFingerprint ?? false;
    bool othersExist = ViewBag.OthersExist ?? false;
    bool isDiscoverable = ViewBag.IsDiscoverable ?? true;
    bool hasOwnContact = ViewBag.HasOwnContact ?? true;
}

<div class="page-wrap">
    <div class="container">
        <div class="matches-header">
            <h1>🤝 Your Top Matches</h1>
            <p class="matches-meta">People whose interests overlap with yours, estimated privately from MinHash fingerprints</p>
        </div>

        @if (!noFingerprint && !isDiscoverable)
        {
            <div class="alert alert-info">
                <span class="alert-icon">🙈</span>
                <span>You're currently <strong>hidden</strong> — you can browse your matches, but you won't appear in theirs. Change this on your <a href="/sources/dashboard">dashboard</a>.</span>
            </div>
        }

        @if (!noFingerprint && !hasOwnContact && Model.Any())
        {
            <div class="alert alert-info">
                <span class="alert-icon">📭</span>
                <span>
                    You haven't shared a way to be reached, so nobody here can answer you.
                    <a href="/account/profile">Add a contact line</a> — it's shown only to people you match with.
                </span>
            </div>
        }

        @if (noFingerprint)
        {
            <div class="empty-state">
                <div class="empty-icon">🔌</div>
                <h4>No fingerprint yet</h4>
                <p>Connect your data sources to generate your fingerprint and find matches.</p>
                <p class="mt-4"><a href="/sources/connect" class="btn btn-primary">Connect Sources</a></p>
            </div>
        }
        else if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">👥</div>
                @if (othersExist)
                {
                    <h4>No close matches yet</h4>
                    <p>Other people are here, but nobody shares enough of your interests to call a match yet. Connecting more sources sharpens your fingerprint — and new members join over time.</p>
                }
                else
                {
                    <h4>You're the first one here</h4>
                    <p>No one else has a fingerprint yet. Invite friends so you have people to match with!</p>
                }
                <p class="mt-4"><a href="/sources/connect" class="btn btn-outline">Add more sources</a></p>
            </div>
        }
        else
        {
            <div class="matches-grid">
                @for (var i = 0; i < Model.Count; i++)
                {
                    var match = Model[i];
                    <div class="match-card">
                        <div class="match-card-body">
                            <div class="match-user">
                                <span class="avatar a@(i % 6 + 1)">@match.Username.Substring(0, 1).ToUpper()</span>
                                <div>
                                    <div class="match-username">@match.Username</div>
                                    @if (match.SharedSources.Any())
                                    {
                                        <div class="match-sources">
                                            @foreach (var s in match.SharedSources)
                                            {
                                                <span class="badge badge-gray">@s</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="match-sources"><span class="text-muted">No sources in common</span></div>
                                    }
                                </div>
                            </div>
                            <div class="compat-row">
                                <span class="compat-pct @match.Tier">@match.TierLabel</span>
                                <span class="text-muted">~@match.SimilarityPercent% shared</span>
                            </div>
                            <div class="match-freshness text-muted">
                                @if (match.IsStale)
                                {
                                    <span title="Their interests haven't been refreshed in a while, so this match is based on an old snapshot.">🕰️ @match.FreshnessLabel</span>
                                }
                                else
                                {
                                    <span>@match.FreshnessLabel</span>
                                }
                            </div>
                            <div class="progress-wrap">
                                <div class="progress-bar @match.Tier" style="width: @match.SimilarityPercent%"></div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(match.Bio))
                            {
                                <p class="match-bio">@match.Bio</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(match.Contact))
                            {
                                <p class="match-contact">📮 @match.Contact</p>
                            }
                            else
                            {
                                <p class="match-contact text-muted">
                                    📭 @match.Username hasn't shared a way to be reached.
                                    @if (hasOwnContact)
                                    {
                                        <text>They can still reach you.</text>
                                    }
                                </p>
                            }
                            <form asp-action="Hide" asp-controller="Matches" method="post" class="match-hide">
                                <input type="hidden" name="username" value="@match.Username" />
                                <button type="submit" class="match-hide-btn" data-no-busy
                                        title="Hide @match.Username from your matches">🙈 Hide</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
            <p class="mt-4 text-center"><a href="/matches/hidden" class="text-muted">Manage hidden people</a></p>
        }
    </div>
</div>
