@model List<Profiler.Web.ViewModels.MatchViewModel>
@{
    ViewBag.Title = "Your Matches";
    bool noFingerprint = ViewBag.NoFingerprint ?? false;
    bool othersExist = ViewBag.OthersExist ?? false;
    bool isDiscoverable = ViewBag.IsDiscoverable ?? true;
    bool hasOwnContact = ViewBag.HasOwnContact ?? true;
    bool hasOwnIntent = ViewBag.HasOwnIntent ?? true;
    bool hasOwnValues = ViewBag.HasOwnValues ?? false;
    string? sortMode = ViewBag.SortMode as string;
    var lens = ViewBag.InterestLens as List<Profiler.Web.Profile.InterestTheme>;
    int lensTotal = ViewBag.InterestLensTotal ?? 0;
    int newSinceLastVisit = ViewBag.NewSinceLastVisit ?? 0;
    var availableSources = ViewBag.AvailableSources as List<string> ?? new List<string>();
    string? sourceFilter = ViewBag.SourceFilter as string;
    bool hasAnyMatch = ViewBag.HasAnyMatch ?? false;
    // Sort links keep any active source filter so the two controls compose.
    var srcQuery = string.IsNullOrEmpty(sourceFilter) ? "" : $"source={Uri.EscapeDataString(sourceFilter)}";
    var sortBase = "/matches" + (srcQuery == "" ? "" : "?" + srcQuery);
    var sortSep = srcQuery == "" ? "?" : "&";
}

<div class="page-wrap">
    <div class="container">
        <div class="matches-header">
            <h1>🤝 Your Top Matches</h1>
            <p class="matches-meta">People whose interests overlap with yours, estimated privately from MinHash fingerprints</p>
        </div>

        @if (newSinceLastVisit > 0)
        {
            <div class="alert alert-info">
                <span class="alert-icon">✨</span>
                <span><strong>@newSinceLastVisit</strong> of your matches @(newSinceLastVisit == 1 ? "has" : "have") refreshed their interests since your last visit.</span>
            </div>
        }

        @if (lens != null && lens.Any())
        {
            <div class="lens-card">
                <div class="lens-head">
                    <span class="lens-icon">✨</span>
                    <div>
                        <strong>Here's what we found in your sources</strong>
                        <span class="lens-sub">@lensTotal signal@(lensTotal == 1 ? "" : "s") — then discarded. Only your anonymous fingerprint is kept.</span>
                    </div>
                </div>
                <div class="lens-themes">
                    @{ var lensMax = lens.Max(t => t.Count); }
                    @foreach (var theme in lens)
                    {
                        <div class="lens-theme">
                            <div class="lens-theme-row">
                                <span class="lens-theme-name">@theme.Name</span>
                                <span class="lens-theme-count">@theme.Count</span>
                            </div>
                            <div class="lens-bar-track">
                                <div class="lens-bar" style="width: @(Math.Max(6, theme.Count * 100 / lensMax))%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (!noFingerprint && !isDiscoverable)
        {
            <div class="alert alert-info">
                <span class="alert-icon">🙈</span>
                <span>You're currently <strong>hidden</strong> — you can browse your matches, but you won't appear in theirs, and their bios and contact details stay hidden from you while you're hidden from them. Change this on your <a href="/sources/dashboard">dashboard</a>.</span>
            </div>
        }

        @if (!noFingerprint && !hasOwnContact && Model.Any())
        {
            <div class="alert alert-info">
                <span class="alert-icon">📭</span>
                <span>
                    You haven't shared a way to be reached, so nobody here can answer you.
                    <a href="/account/profile">Add a contact line</a> — it's shown only to people you match with.
                </span>
            </div>
        }

        @if (!noFingerprint && !hasOwnIntent && Model.Any())
        {
            <div class="alert alert-info">
                <span class="alert-icon">🎯</span>
                <span>
                    Sharing interests isn't the same as wanting the same thing.
                    <a href="/account/profile">Say what you're here for</a> so your matches know — and so you can see who's here for it too.
                </span>
            </div>
        }

        @if (noFingerprint)
        {
            <div class="empty-state">
                <div class="empty-icon">🔌</div>
                <h4>No fingerprint yet</h4>
                <p>Connect your data sources to generate your fingerprint and find matches.</p>
                <p class="mt-4"><a href="/sources/connect" class="btn btn-primary">Connect Sources</a></p>
            </div>
        }
        else if (hasAnyMatch && !Model.Any())
        {
            @* A filter is active and excludes everything, but the user does have matches. *@
            @await Html.PartialAsync("_SourceFilterChips", (availableSources, sourceFilter))
            <div class="empty-state">
                <div class="empty-icon">🔍</div>
                <h4>No matches share @sourceFilter</h4>
                <p>None of your matches has @sourceFilter in common with you. Try another interest area.</p>
                <p class="mt-4"><a href="/matches" class="btn btn-primary">Show all matches</a></p>
            </div>
        }
        else if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">👥</div>
                @if (othersExist)
                {
                    <h4>No close matches yet</h4>
                    <p>Other people are here, but nobody shares enough of your interests to call a match yet. Connecting more sources sharpens your fingerprint — and new members join over time.</p>
                }
                else
                {
                    <h4>You're the first one here</h4>
                    <p>No one else has a fingerprint yet. Invite people who'd want to match with you — Profiler only works once your people are here too.</p>
                }

                <div class="invite-box">
                    <label class="invite-label">Share this link</label>
                    <div class="invite-row">
                        <input type="text" class="form-control invite-input" value="@ViewBag.InviteUrl" readonly aria-label="Invite link" />
                        <button type="button" class="btn btn-primary" data-copy="@ViewBag.InviteUrl" data-no-busy>Copy link</button>
                    </div>
                    <small class="text-muted">Anyone with the link can join. We never see who you invited.</small>
                </div>

                <p class="mt-4"><a href="/sources/connect" class="btn btn-outline">Add more sources</a></p>
            </div>
        }
        else
        {
            @await Html.PartialAsync("_SourceFilterChips", (availableSources, sourceFilter))
            @if (hasOwnIntent || hasOwnValues)
            {
                <div class="source-filter" role="group" aria-label="Sort matches">
                    <span class="sort-label">Prioritise:</span>
                    <a class="filter-chip @(sortMode == null ? "active" : "")" href="@sortBase">Best match</a>
                    @if (hasOwnIntent)
                    {
                        <a class="filter-chip @(sortMode == "intent" ? "active" : "")" href="@(sortBase + sortSep + "sort=intent")">Same intent first</a>
                    }
                    @if (hasOwnValues)
                    {
                        <a class="filter-chip @(sortMode == "values" ? "active" : "")" href="@(sortBase + sortSep + "sort=values")">Similar outlook first</a>
                    }
                </div>
            }
            <div class="matches-grid">
                @for (var i = 0; i < Model.Count; i++)
                {
                    var match = Model[i];
                    <div class="match-card">
                        <div class="match-card-body">
                            <div class="match-user">
                                <span class="avatar a@(i % 6 + 1)">@match.Username.Substring(0, 1).ToUpper()</span>
                                <div>
                                    <div class="match-username">@match.Username</div>
                                    @if (match.SharedSources.Any())
                                    {
                                        <div class="match-sources">
                                            @foreach (var s in match.SharedSources)
                                            {
                                                <span class="badge badge-gray">@s</span>
                                            }
                                        </div>
                                        @if (match.StrongestOverlap is { } best)
                                        {
                                            <div class="match-strongest">
                                                Closest on <strong>@best.Source</strong> (~@best.SimilarityPercent% there)
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="match-sources"><span class="text-muted">No sources in common</span></div>
                                    }
                                </div>
                            </div>
                            <div class="compat-row">
                                <span class="compat-pct @match.Tier">@match.TierLabel</span>
                                <span class="text-muted">~@match.SimilarityPercent% shared</span>
                            </div>
                            <div class="match-freshness text-muted">
                                @if (match.IsStale)
                                {
                                    <span title="Their interests haven't been refreshed in a while, so this match is based on an old snapshot.">🕰️ @match.FreshnessLabel</span>
                                }
                                else
                                {
                                    <span>@match.FreshnessLabel</span>
                                }
                            </div>
                            <div class="progress-wrap">
                                @* Bar width is rescaled to the realistic Jaccard range (see BarPercent);
                                   the honest estimate is the "~X% shared" text above, not the bar. *@
                                <div class="progress-bar @match.Tier" style="width: @match.BarPercent%"></div>
                            </div>
                            @* Compatibility signals grouped together, right after the match strength. *@
                            @if (!string.IsNullOrWhiteSpace(match.ConnectionIntentLabel))
                            {
                                @if (match.SharesViewerIntent)
                                {
                                    <p class="match-intent match-intent-shared">🎯 You're both here for: @match.ConnectionIntentLabel</p>
                                }
                                else
                                {
                                    <p class="match-intent">🎯 Here for: @match.ConnectionIntentLabel</p>
                                }
                            }
                            @if (!string.IsNullOrWhiteSpace(match.ValuesAlignmentLabel))
                            {
                                <p class="match-values">🧭 @match.ValuesAlignmentLabel</p>
                            }
                            @* Their words, then how to reach them — the personal block. *@
                            @if (!string.IsNullOrWhiteSpace(match.Bio))
                            {
                                <p class="match-bio">@match.Bio</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(match.Contact))
                            {
                                <p class="match-contact">📮 @match.Contact</p>
                            }
                            else if (!isDiscoverable)
                            {
                                <p class="match-contact text-muted">
                                    🙈 Hidden while you are. Become discoverable to see how people can be reached.
                                </p>
                            }
                            else
                            {
                                <p class="match-contact text-muted">
                                    📭 @match.Username hasn't shared a way to be reached.
                                    @if (hasOwnContact)
                                    {
                                        <text>They can still reach you.</text>
                                    }
                                </p>
                            }
                            <form asp-action="Hide" asp-controller="Matches" method="post" class="match-hide">
                                <input type="hidden" name="username" value="@match.Username" />
                                <button type="submit" class="match-hide-btn" data-no-busy
                                        title="Hide @match.Username from your matches">🙈 Hide</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
            <p class="mt-4 text-center"><a href="/matches/hidden" class="text-muted">Manage hidden people</a></p>
        }
    </div>
</div>
