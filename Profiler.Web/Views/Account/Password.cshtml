@model Profiler.Web.ViewModels.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>🔑 Change Password</h1>
        <p class="text-center text-muted mb-4">Enter your current password, then choose a new one.</p>
        <form asp-action="Password" asp-controller="Account" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="form-group">
                <label asp-for="CurrentPassword" class="form-label">Current password</label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="NewPassword" class="form-label">New password</label>
                <input asp-for="NewPassword" class="form-control" placeholder="Min 8 characters" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmNewPassword" class="form-label">Confirm new password</label>
                <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Repeat new password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Change password</button>
        </form>
        <hr class="auth-divider" />
        <div class="auth-footer">
            <p><a href="/sources/dashboard">← Back to dashboard</a></p>
        </div>
    </div>
</div>
