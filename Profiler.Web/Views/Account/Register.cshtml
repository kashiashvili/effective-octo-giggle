@model Profiler.Web.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Register";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h2>🚀 Create Account</h2>
        <p class="text-center text-muted mb-4">Join Profiler — free, private, open</p>
        <form asp-action="Register" asp-controller="Account" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input asp-for="FormTicket" type="hidden" />
            @* Honeypot: hidden from people, tempting to form-filling bots. A real submission leaves it
               empty. Kept out of the tab order and hidden from assistive tech. *@
            <div class="hp-field" aria-hidden="true">
                <label for="Website">Website</label>
                <input asp-for="Website" id="Website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <div class="form-group">
                <label asp-for="Username" class="form-label">Username</label>
                <input asp-for="Username" class="form-control" placeholder="Choose a username" autocomplete="username" />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" placeholder="Min 8 characters" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Create Account</button>
        </form>
        <hr class="auth-divider" />
        <div class="auth-footer">
            <p>Already have an account? <a href="/account/login">Sign in</a></p>
        </div>
    </div>
</div>
