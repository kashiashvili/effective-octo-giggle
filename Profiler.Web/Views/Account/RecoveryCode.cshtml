@model string
@{
    ViewBag.Title = "Your Recovery Code";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>🔑 Save your recovery code</h1>
        <p class="text-center text-muted mb-4">
            This is the only way back into your account if you forget your password.
        </p>

        <div class="recovery-code">@Model</div>

        <div class="alert alert-danger">
            <span class="alert-icon">⚠️</span>
            <span>
                <strong>It will not be shown again.</strong> We store only a hash of it, so nobody —
                including us — can produce it for you later. Write it down or put it in your password
                manager now.
            </span>
        </div>

        <p class="text-muted" style="font-size: .85rem">
            We don't ask for your email address, so there is no reset link to send. That's the trade:
            no contact details on file, and this code instead.
        </p>

        @if (TempData.Peek("CircleInvite") is string invite && Profiler.Web.Security.CircleInvites.LooksLikeToken(invite))
        {
            <a href="/circles/join/@Uri.EscapeDataString(invite)" class="btn btn-primary btn-block">I've saved it — join the circle I was invited to</a>
            <p class="text-center mt-2"><a href="/sources/interests">Skip the circle, pick my interests</a></p>
        }
        else
        {
            <a href="/sources/interests" class="btn btn-primary btn-block">I've saved it — pick my interests</a>
        }
        <hr class="auth-divider" />
        <div class="auth-footer">
            <p><a href="/sources/connect">Connect a source instead</a> · <a href="/sources/dashboard">Back to dashboard</a></p>
        </div>
    </div>
</div>
