@model Profiler.Web.ViewModels.ValuesViewModel
@using Profiler.Web.Profile
@{
    ViewBag.Title = "Values & worldview";
    bool hasValues = ViewBag.HasValues ?? false;
    var summary = ViewBag.Summary as List<(string Name, string Science, string Reading, int Level)>;
    // On a redisplay (a missed consent box, say) the answers are still in this request: keep them
    // selected rather than making someone answer fourteen questions again. Still never stored.
    int? Chosen(string key) => Model.Answers.TryGetValue(key, out var v) ? v : null;
}

<div class="page-wrap">
    <div class="container" style="max-width: 680px">
        <div class="page-header">
            <h1><span aria-hidden="true">🧭</span> What matters to you <span class="badge badge-light">Optional</span></h1>
            <p>Two minutes: ten things that might matter to you, and four about how you see the world. Matches then see whether you share priorities — never your answers.</p>
        </div>

        @if (hasValues && summary != null)
        {
            <div class="card mb-4">
                <div class="card-header teal">Your profile</div>
                <div class="card-body">
                    <p class="text-muted mb-3">Relative to your own average — what you put ahead of the rest, not how you score against anyone.</p>
                    <ul class="action-list">
                        @foreach (var row in summary)
                        {
                            <li class="source-row" style="display:block">
                                <strong>@row.Name</strong> <small class="text-muted">(@row.Science)</small><br />
                                <span>@row.Reading</span>
                            </li>
                        }
                    </ul>
                    <p class="text-muted mt-3 mb-0">Answer again below to update it, or remove it at the bottom.</p>
                </div>
            </div>
        }

        <div class="card mb-4">
            <div class="card-body">
                <p class="mb-2"><strong>The science, in three sentences.</strong></p>
                <p class="text-muted mb-2">
                    Part 1 follows Schwartz's theory of basic human values: ten values that people everywhere
                    recognise, summarised as four priorities — new experiences and independence; stability,
                    tradition and fitting in; caring for people and the planet; achievement and influence.
                    Your ratings are read relative to your own average, so the result is what you put first,
                    not how generously you use the scale.
                </p>
                <p class="text-muted mb-2">
                    Part 2 is two "primal world beliefs" — whether the world feels safe, and whether it feels
                    interesting — which research finds to be stable, general outlooks on life. Nothing here
                    asks about politics, religion or morality. Friends turn out to share values more than
                    strangers do, and shared values predict liking especially between people who have just
                    met, which is exactly where every match starts.
                </p>
                <p class="text-muted mb-0">
                    <strong>Not a test, not a type.</strong> There are no right answers and no personality
                    label. <strong>Your answers are discarded</strong> once six small numbers are worked out;
                    only those are stored, and matches see a coarse "similar / different priorities" with the
                    reason — never the numbers. Remove it any time. Sources are listed in the project handbook.
                </p>
            </div>
        </div>

        <form asp-action="Values" asp-controller="Account" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <h2 class="source-group-title">Part 1 · How important is each of these to you, as a guiding principle in your life?</h2>
            @foreach (var item in ValuesQuestionnaire.ValueItems)
            {
                <fieldset class="card mb-3">
                    <legend class="card-body pb-0">
                        <strong>@item.Name</strong><br />
                        <span class="text-muted">@item.Description</span>
                    </legend>
                    <div class="card-body pt-2">
                        <div class="likert">
                            @for (var v = ValuesQuestionnaire.MinAnswer; v <= ValuesQuestionnaire.MaxAnswer; v++)
                            {
                                var id = $"{item.Key}_{v}";
                                <label class="likert-option" for="@id">
                                    <input type="radio" id="@id" name="Answers[@item.Key]" value="@v" required
                                           checked="@(Chosen(item.Key) == v)"
                                           aria-label="@item.Name: @v of @ValuesQuestionnaire.MaxAnswer, @ValuesQuestionnaire.ImportanceWord(v)" />
                                    <span class="likert-num" aria-hidden="true">@v</span>
                                </label>
                            }
                        </div>
                        <div class="likert-scale" aria-hidden="true">
                            <span>Not important to me</span>
                            <span>Extremely important</span>
                        </div>
                    </div>
                </fieldset>
            }

            <h2 class="source-group-title mt-4">Part 2 · How much do you agree?</h2>
            @foreach (var item in ValuesQuestionnaire.WorldItems)
            {
                <fieldset class="card mb-3">
                    <legend class="card-body pb-0"><strong>@item.Statement</strong></legend>
                    <div class="card-body pt-2">
                        <div class="likert">
                            @for (var v = ValuesQuestionnaire.MinAnswer; v <= ValuesQuestionnaire.MaxAnswer; v++)
                            {
                                var id = $"{item.Key}_{v}";
                                <label class="likert-option" for="@id">
                                    <input type="radio" id="@id" name="Answers[@item.Key]" value="@v" required
                                           checked="@(Chosen(item.Key) == v)"
                                           aria-label="@item.Statement @v of @ValuesQuestionnaire.MaxAnswer, @ValuesQuestionnaire.AgreementWord(v)" />
                                    <span class="likert-num" aria-hidden="true">@v</span>
                                </label>
                            }
                        </div>
                        <div class="likert-scale" aria-hidden="true">
                            <span>Strongly disagree</span>
                            <span>Strongly agree</span>
                        </div>
                    </div>
                </fieldset>
            }

            <div class="form-group">
                <label class="check-inline">
                    <input asp-for="Consent" type="checkbox" value="true" />
                    <span>
                        I understand this is optional, is a rough self-description (not a test or a personality
                        type), that my answers are discarded after six coarse numbers are derived, and that people
                        I match with will see whether our priorities are similar — including which priority I put
                        first — but never my answers.
                    </span>
                </label>
                <span asp-validation-for="Consent" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">@(hasValues ? "Update my profile" : "Save my profile")</button>
        </form>

        @if (hasValues)
        {
            <form asp-action="DeleteValues" asp-controller="Account" method="post" class="mt-3">
                <button type="submit" class="btn btn-outline btn-block" data-no-busy>Remove my values profile</button>
            </form>
        }

        <hr class="auth-divider" />
        <p><a href="/sources/dashboard">← Back to dashboard</a> · <a href="/matches">Your matches</a></p>
    </div>
</div>
