@model Profiler.Web.ViewModels.ValuesViewModel
@{
    ViewBag.Title = "Values profile";
    bool hasValues = ViewBag.HasValues ?? false;
    var items = Profiler.Web.Profile.ValuesQuestionnaire.Items;
}

<div class="page-wrap">
    <div class="container" style="max-width: 640px">
        <div class="page-header">
            <h1>🧭 Your values profile <span class="badge badge-light">Optional</span></h1>
            <p>A few quick questions about how you approach new things. Optional, and separate from your interests.</p>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <p class="mb-2"><strong>What this is — and isn't.</strong></p>
                <p class="text-muted mb-2">
                    This places you roughly on one dimension — how much you lean toward new experiences
                    versus familiar ones. It's a rough self-description you choose to share, not a
                    personality test, a score, or a judgement. There are no right answers.
                </p>
                <p class="text-muted mb-0">
                    <strong>Your answers are discarded.</strong> We use them once to work out a single
                    coarse position, store only that, and throw the answers away — the same way we
                    handle your interests. Matches only ever see a rough "similar / different outlook",
                    never your answers. You can remove it any time.
                </p>
            </div>
        </div>

        <form asp-action="Values" asp-controller="Account" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            @for (var i = 0; i < items.Count; i++)
            {
                var item = items[i];
                <div class="card mb-3">
                    <div class="card-body">
                        <p class="mb-3"><strong>@item.Statement</strong></p>
                        <div class="likert">
                            @for (var v = Profiler.Web.Profile.ValuesQuestionnaire.MinAnswer; v <= Profiler.Web.Profile.ValuesQuestionnaire.MaxAnswer; v++)
                            {
                                var id = $"{item.Key}_{v}";
                                <label class="likert-option" for="@id">
                                    <input type="radio" id="@id" name="Answers[@item.Key]" value="@v" required />
                                    <span class="likert-num">@v</span>
                                </label>
                            }
                        </div>
                        <div class="likert-scale">
                            <span>Strongly disagree</span>
                            <span>Strongly agree</span>
                        </div>
                    </div>
                </div>
            }

            <div class="form-group">
                <label class="check-inline">
                    <input asp-for="Consent" type="checkbox" value="true" />
                    <span>I understand this is optional, is a rough self-description (not a test or diagnosis), and that my answers are discarded after a coarse position is derived.</span>
                </label>
                <span asp-validation-for="Consent" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Save my values profile</button>
        </form>

        @if (hasValues)
        {
            <form asp-action="DeleteValues" asp-controller="Account" method="post" class="mt-3">
                <button type="submit" class="btn btn-outline btn-block" data-no-busy>Remove my values profile</button>
            </form>
        }

        <hr class="auth-divider" />
        <p><a href="/sources/dashboard">← Back to dashboard</a></p>
    </div>
</div>
