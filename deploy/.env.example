# Copy to deploy/.env.production and fill in. That file is gitignored — never commit real secrets.
#
#   cp deploy/.env.example deploy/.env.production
#   # generate the two secrets:
#   echo "Fingerprint__Pepper=$(openssl rand -base64 32)" >> deploy/.env.production
#   echo "Metrics__Token=$(openssl rand -base64 24)"      >> deploy/.env.production

# REQUIRED. Per-deployment secret mixed into every fingerprint hash. The app refuses to start without
# it outside Development. Back it up: changing or losing it invalidates every stored fingerprint and
# every user must reconnect their sources.
Fingerprint__Pepper=

# Operator bearer token. Gates GET /metrics (aggregate adoption), GET /metrics/reports (moderation
# review) and POST /metrics/suspend (suspend/reinstate). All 404 while this is unset.
Metrics__Token=

ASPNETCORE_ENVIRONMENT=Production

# The database and the Data Protection key ring live on the mounted /data volume.
ConnectionStrings__Default=Data Source=/data/profiler.db
DataProtection__KeyPath=/data/keys

# Anti-sybil on registration (honeypot is always on; this adds the signed single-use form ticket).
# Recommended true for a public launch.
AntiAbuse__GuardRegistration=true
# AntiAbuse__MinFormSeconds=3

# Optional: hide the values/outlook signal entirely (questionnaire, match-card line, and the
# "Similar outlook first" sort). See docs/OWNER_DECISIONS.md — the data-minimizing choice until the
# signal is strengthened. Stored buckets are kept, so it re-enables cleanly.
# Signals__ValuesEnabled=false
